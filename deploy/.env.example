# Copy to deploy/.env on the Docker host and fill in every required value.
#   cp deploy/.env.example deploy/.env
#
# Never commit deploy/.env.

COMPOSE_PROJECT_NAME=paperless

# Public URL served by Cloudflare Tunnel. No trailing slash.
PAPERLESS_URL=https://paperless.smmiri.com

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=

# Required. Used by Postgres and Paperless.
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=

# Optional first-boot superuser. Leave blank to create it later with:
#   docker compose exec webserver createsuperuser
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_ADMIN_MAIL=

# Host user that writes to ./consume and ./export.
# USERMAP_UID=1000
# USERMAP_GID=1000

# PAPERLESS_TIME_ZONE=America/New_York
# PAPERLESS_OCR_LANGUAGE=eng
# PAPERLESS_OCR_LANGUAGES=

# Cloudflare Tunnel token from Zero Trust > Networks > Tunnels.
# The public hostname must be paperless.smmiri.com -> http://webserver:8000
CLOUDFLARE_TUNNEL_TOKEN=

# Optional label baked into a custom image build.
# PNGX_TAG_VERSION=
